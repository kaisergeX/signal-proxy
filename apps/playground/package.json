{
  "name": "playground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "tsc --noEmit && eslint src --report-unused-disable-directives --max-warnings 0 && prettier --check \"src/**/*.{ts,tsx,scss}\"",
    "preview": "vite preview"
  },
  "imports": {
    "#*": "./src/*/index.ts",
    "#*/": "./src/*"
  },
  "dependencies": {
    "@kaiverse/k": "^0.6.0",
    "@kaiverse/signal-react": "workspace:*",
    "@tailwindcss/vite": "4.0.0-alpha.19",
    "@tanstack/react-router": "^1.76.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "4.0.0-alpha.19"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@tanstack/router-devtools": "^1.76.1",
    "@tanstack/router-plugin": "^1.76.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react-swc": "^3.7.1",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.6",
    "typescript": "^5.5.3",
    "vite": "^5.4.10"
  }
}
