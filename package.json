{
  "name": "signal-proxy",
  "private": true,
  "repository": "https://github.com/kaisergeX/signal-proxy.git",
  "keywords": [
    "signal",
    "proxy",
    "reactive",
    "reactivity",
    "typescript"
  ],
  "scripts": {
    "build": "turbo build",
    "build:pkgs": "turbo build --filter=./packages/*",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:pkgs": "turbo lint --filter=@kaiverse/*",
    "format": "prettier --check \"**/*.{ts,tsx,md}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "clean": "rm -rf {node_modules,.turbo} && pnpm -r exec rm -rf {node_modules,dist,.turbo}",
    "cs": "changeset",
    "publish:npm": "turbo run build lint --filter=@kaiverse/* && pnpm publish --filter '@kaiverse/*' --access public && changeset tag",
    "publish:jsr": "cd ./packages/signal && pnpm dlx jsr publish",
    "publish:jsr-react-adapter": "cd ./packages/signal-react && pnpm dlx jsr publish"
  },
  "type": "module",
  "devDependencies": {
    "@changesets/cli": "^2.27.7",
    "@types/node": "^26.4.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^5.6.2"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  }
}