{
  "name": "@kaiverse/signal-react",
  "version": "0.4.0",
  "description": "React adapter for @kaiverse/signal",
  "author": "Vu Duc Khai",
  "license": "MIT",
  "keywords": [
    "signal",
    "react",
    "reactivity"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kaisergeX/signal-proxy.git",
    "directory": "packages/signal-react"
  },
  "bugs": {
    "url": "https://github.com/kaisergeX/signal-proxy/issues"
  },
  "homepage": "https://kaisergex.github.io/kaiverse/hooks/signal",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#hooks": "./lib/index.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p ./tsconfig.lib.json && vite build",
    "lint": "tsc -p ./tsconfig.lib.json --noEmit && eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:dev": "tsc -p ./tsconfig.lib.json --noEmit && tsc -p ./tsconfig.app.json --noEmit && eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@kaiverse/signal": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@kaiverse/k": "^0.7.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "eslint": "^10.9.1",
    "globals": "^15.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.2",
    "vite": "^6.3.6",
    "vite-plugin-dts": "^4.5.4"
  }
}
