{
  "name": "@kaiverse/signal-react",
  "version": "0.3.0",
  "description": "React adapter for @kaiverse/signal",
  "author": "Vu Duc Khai",
  "license": "MIT",
  "keywords": [
    "signal",
    "react",
    "reactivity"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kaisergeX/signal-proxy.git",
    "directory": "packages/signal-react"
  },
  "bugs": {
    "url": "https://github.com/kaisergeX/signal-proxy/issues"
  },
  "homepage": "https://github.com/kaisergeX/signal-proxy",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#hooks": "./lib/index.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/signal-react.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p ./tsconfig.lib.json && vite build",
    "lint": "tsc -p ./tsconfig.lib.json --noEmit && eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:dev": "tsc -p ./tsconfig.lib.json --noEmit && tsc -p ./tsconfig.app.json --noEmit && eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@kaiverse/signal": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "globals": "^15.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.0.3"
  }
}
