{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "@kaiverse/signal-react#build": {
      "dependsOn": ["@kaiverse/signal#build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "@kaiverse/signal-react#lint": {
      "dependsOn": ["@kaiverse/signal#build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
